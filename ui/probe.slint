import { Button, CheckBox, ComboBox, LineEdit, ScrollView, VerticalBox } from "std-widgets.slint";

export component ProbeWindow inherits Window {
    title: "PowerPlanSync - sonde d'interface";
    preferred-width: 520px;
    preferred-height: 520px;
    min-width: 360px;
    min-height: 260px;
    callback hide-requested();
    callback quit-requested();
    in-out property <string> local-status: "Sonde prête";

    scroll := ScrollView {
        content-width: self.visible-width;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        VerticalBox {
            width: scroll.visible-width;
            padding: 24px;
            spacing: 12px;

            Text {
                text: "PowerPlanSync";
                font-size: 24px;
                font-weight: 700;
            }
            Text {
                text: "Prototype de l'interface, sans écriture dans les réglages Windows.";
                wrap: word-wrap;
            }
            Text {
                text: "Plan actif : lecture seule";
                font-size: 18px;
                font-weight: 600;
            }
            Text { text: "Logiciel"; }
            LineEdit {
                accessible-label: "Logiciel";
                placeholder-text: "Exemple : demo_target.exe";
                edited => { root.local-status = "Logiciel saisi pour la démonstration"; }
            }
            Text { text: "Plan pendant l'exécution"; }
            ComboBox {
                accessible-label: "Plan pendant l'exécution";
                model: ["Utilisation normale (démo)", "Haute performance (démo)"];
                selected => { root.local-status = "Plan de démonstration sélectionné"; }
            }
            CheckBox {
                text: "Activer le suivi (démonstration)";
                toggled => {
                    root.local-status = self.checked ? "Suivi de démonstration activé" : "Suivi de démonstration désactivé";
                }
            }
            Text {
                text: "État : " + root.local-status;
                wrap: word-wrap;
            }
            VerticalBox {
                spacing: 12px;
                Button {
                    text: "Masquer dans la zone de notification";
                    clicked => { root.hide-requested(); }
                }
                Button {
                    text: "Quitter";
                    clicked => { root.quit-requested(); }
                }
            }
        }
    }
}

export component ProbeTray inherits SystemTrayIcon {
    in property <image> tray-icon;
    icon: tray-icon;
    title: "PowerPlanSync";
    tooltip: "PowerPlanSync - sonde prête";
    callback open-requested();
    callback quit-requested();
    clicked => { root.open-requested(); }

    Menu {
        MenuItem {
            title: "Ouvrir PowerPlanSync";
            activated => { root.open-requested(); }
        }
        MenuItem {
            title: "État : sonde prête";
            enabled: false;
        }
        MenuItem {
            title: "Quitter";
            activated => { root.quit-requested(); }
        }
    }
}
