export component PowerPlanTray inherits SystemTrayIcon {
    in property <image> tray-icon;
    in property <string> current-status: "Prêt";
    in property <bool> paused: false;
    in property <bool> has-error: false;
    icon: tray-icon;
    title: "PowerPlanSync";
    tooltip: "PowerPlanSync — " + root.current-status;
    callback open-requested();
    callback pause-requested();
    callback resume-requested();
    callback quit-requested();
    clicked => { root.open-requested(); }

    Menu {
        MenuItem { title: "Ouvrir PowerPlanSync"; activated => { root.open-requested(); } }
        MenuItem { title: "État : " + root.current-status; enabled: false; }
        MenuItem { title: root.paused ? "Reprendre" : "Pause"; activated => { if (root.paused) { root.resume-requested(); } else { root.pause-requested(); } } }
        MenuItem { title: "Quitter"; activated => { root.quit-requested(); } }
    }
}
